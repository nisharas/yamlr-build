<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>yamlr</id>
    <version>@VERSION@</version>
    <title>Yamlr K8s Safety Engine</title>
    <authors>Yamlr Team</authors>
    <owners>Yamlr</owners>
    <projectUrl>https://yamlr.dev</projectUrl>
    <iconUrl>https://yamlr.dev/assets/logo.png</iconUrl>
    <licenseUrl>https://yamlr.dev/license</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <description>
      Yamlr is the industry's first autonomous Safety Engine for Kubernetes.
      It detects and repairs security, reliability, and configuration issues
      in your K8s manifests with surgical precision, preserving your comments
      and formatting.
    </description>
    <summary>Autonomous K8s Safety & Healing Engine</summary>
    <releaseNotes>https://yamlr.dev/release-notes</releaseNotes>
    <copyright>Copyright 2026 Yamlr</copyright>
    <tags>kubernetes k8s devops security yaml healing automation</tags>
    <docsUrl>https://docs.yamlr.dev</docsUrl>
  </metadata>
  <files>
    <file src="bin\yamlr.exe" target="tools" />
  </files>
</package>
